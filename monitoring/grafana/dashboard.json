{
  "uid": "protocare-rag-monitoring",
  "title": "ProtoCare RAG — Monitoring",
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Requêtes RAG / minute",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "targets": [{ "expr": "rate(rag_requests_total[1m]) * 60", "legendFormat": "req/min" }],
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 10 }, { "color": "red", "value": 30 }] } } }
    },
    {
      "id": 2,
      "title": "Latence moyenne RAG (s)",
      "type": "stat",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "targets": [{ "expr": "rate(rag_request_duration_seconds_sum[5m]) / rate(rag_request_duration_seconds_count[5m])", "legendFormat": "latence moy" }],
      "fieldConfig": { "defaults": { "unit": "s", "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 30 }, { "color": "red", "value": 60 }] } } }
    },
    {
      "id": 3,
      "title": "Latence P95 (s)",
      "type": "stat",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "targets": [{ "expr": "histogram_quantile(0.95, rate(rag_request_duration_seconds_bucket[5m]))", "legendFormat": "p95" }],
      "fieldConfig": { "defaults": { "unit": "s", "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 40 }, { "color": "red", "value": 80 }] } } }
    },
    {
      "id": 4,
      "title": "Taux d'erreurs (%)",
      "type": "stat",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "targets": [{ "expr": "rate(rag_requests_total{status=\"error\"}[5m]) / rate(rag_requests_total[5m]) * 100", "legendFormat": "erreurs %" }],
      "fieldConfig": { "defaults": { "unit": "percent", "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 5 }, { "color": "red", "value": 10 }] } } }
    },
    {
      "id": 5,
      "title": "Latence dans le temps",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [
        { "expr": "rate(rag_request_duration_seconds_sum[5m]) / rate(rag_request_duration_seconds_count[5m])", "legendFormat": "Latence moyenne" },
        { "expr": "histogram_quantile(0.95, rate(rag_request_duration_seconds_bucket[5m]))", "legendFormat": "P95" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 6,
      "title": "Qualité RAG (DeepEval)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "targets": [
        { "expr": "rag_answer_relevance_avg", "legendFormat": "Answer Relevance" },
        { "expr": "rag_faithfulness_avg", "legendFormat": "Faithfulness" },
        { "expr": "rag_precision_at_k_avg", "legendFormat": "Precision@k" },
        { "expr": "rag_recall_at_k_avg", "legendFormat": "Recall@k" }
      ],
      "fieldConfig": { "defaults": { "min": 0, "max": 1 } }
    },
    {
      "id": 7,
      "title": "CPU Backend (%)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "targets": [{ "expr": "sum(rate(container_cpu_usage_seconds_total{name=\"protocare_backend\"}[1m])) * 100", "legendFormat": "CPU %" }],
      "fieldConfig": { "defaults": { "unit": "percent", "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 60 }, { "color": "red", "value": 80 }] } } }
    },
    {
      "id": 8,
      "title": "RAM Backend (MB)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "targets": [{ "expr": "container_memory_usage_bytes{name=\"protocare_backend\"} / 1024 / 1024", "legendFormat": "RAM MB" }],
      "fieldConfig": { "defaults": { "unit": "megabytes" } }
    },
    {
      "id": 9,
      "title": "Succès vs Erreurs",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 20, "w": 24, "h": 8 },
      "targets": [
        { "expr": "rate(rag_requests_total{status=\"success\"}[1m])", "legendFormat": "Succès" },
        { "expr": "rate(rag_requests_total{status=\"error\"}[1m])", "legendFormat": "Erreurs" }
      ]
    }
  ]
}